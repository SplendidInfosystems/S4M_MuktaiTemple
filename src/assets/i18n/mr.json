  "ABOUT_US": {
    "TITLE": "आमच्याबद्दल",
    "SUBTITLE": "श्री मुक्ताई देवी मंदिराचा इतिहास आणि आध्यात्मिक महत्त्व",
    "HISTORY_TITLE": "इतिहास",
    "HISTORY_PARA_1": "मुक्ताई देवी मंदिराचा इतिहास शेकडो वर्षांचा आहे. मुक्ताई देवी या संत एकनाथ महाराजांच्या मातोश्री होत्या. त्यांच्या भक्ती, तपस्या आणि पवित्र जीवनामुळे त्यांची देवी म्हणून पूजा केली जाऊ लागली.",
    "HISTORY_PARA_2": "पैठण येथे जन्मलेल्या मुक्ताई देवी यांनी संत एकनाथ महाराजांना अध्यात्माच्या मार्गावर प्रेरित केले. त्यांच्या कृपेने संत एकनाथ महाराजांनी अनेक चमत्कार केले आणि समाजात सामाजिक सुधारणा घडवून आणल्या.",
    "SPIRITUAL_TITLE": "आध्यात्मिक महत्त्व",
    "SPIRITUAL_PARA_1": "मुक्ताई देवीची आराधना करणाऱ्या भक्तांना मानसिक शांती, कौटुंबिक सुख आणि आध्यात्मिक उन्नती प्राप्त होते. देवीची कृपा सर्व संकटे दूर करते आणि जीवनात सकारात्मकता आणते.",
    "SPIRITUAL_PARA_2": "विशेषतः महिलांसाठी मुक्ताई देवी एक आदर्श आहे. तिच्या जीवनातील त्याग, समर्पण आणि भक्ती प्रत्येकासाठी प्रेरणादायी आहे."
  },
